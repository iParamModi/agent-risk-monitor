# Build context for deploy/Dockerfile: nothing by default, then only what the replay site reads.
# .env, ops/, data/, .git and the model folders can never reach the image.
*

!requirements-server.txt
!PROGRESS.md
!src/
!lma_agent/
!outputs/
outputs/*
!outputs/live/
outputs/live/*
!outputs/live/demo/
!docs/
docs/*
!docs/reports/
docs/reports/*
!docs/reports/final_results_v2.json
!report/
report/*
!report/final_submission.pdf

**/__pycache__
**/*.pyc
**/.env
**/.env.*
