# Names only. Prateek copies this to deploy/.env ON THE VM, fills it in himself and runs: chmod 600 deploy/.env
# deploy/.env is git-ignored. Nobody else reads it, and no value is ever written in this file.

# --- needed for the replay-only site (Part F)
# the site's name, e.g. a DuckDNS subdomain or <ip>.sslip.io; Caddy gets the HTTPS certificate for it
DOMAIN=
# the VM user that owns the checkout: the output of `id -u` and `id -g` on the VM
APP_UID=
APP_GID=
# off (the default when empty). Replay only.
LIVE_MODE=

# --- live mode only (Part G). Leave all of these empty for the replay-only site: the containers do not get them.
LIVE_PASSWORD=
ALLOW_PAID_CALLS=
GROQ_API_KEY=
MODAL_URL=
MODAL_TOKEN=
