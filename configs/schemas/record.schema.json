{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record.schema.json",
  "title": "Record",
  "description": "One data record: ours (task=decide_action) or external R-Judge/ATBench/AgentRisk (task=judge_trajectory). DATASET.md section 4. DRAFT, not locked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "seed_id", "source", "set", "split", "domain", "case_type",
               "subtype", "pair_side", "version", "task", "visible", "hidden", "gold", "meta"],
  "properties": {
    "record_id": {
      "description": "Ours: <seed_id>-<A|B|a|b|c|d|v1|v2>. R-Judge: RJ-<file stem>-<id>. ATBench: ATB-<id>. AgentRisk: AR-<number of AGENTRISK-NNN>.",
      "type": "string",
      "pattern": "^((IND|OOD)-[A-Z]+-T[1-5]-[0-9]{3}-(A|B|a|b|c|d|v1|v2)|RJ-[A-Za-z0-9_]+-[0-9]+|ATB-[0-9]+|AR-[0-9]{3,})$"
    },
    "seed_id": {
      "description": "Splitting / bootstrap unit. Ours: IND-PRIV-T2-014. R-Judge: RJ-scn-<file stem>. ATBench: ATB-grp-<8 hex of tool-group hash>. AgentRisk: AR-grp-<scenario_group>.",
      "type": "string",
      "pattern": "^((IND|OOD)-[A-Z]+-T[1-5]-[0-9]{3}|RJ-scn-[A-Za-z0-9_]+|ATB-grp-[0-9a-f]{8}|AR-grp-G[0-9]{3,})$"
    },
    "source":    {"description": "Where the record comes from.", "enum": ["synthetic-data", "r_judge", "atbench", "agentrisk"]},
    "set":       {"description": "in_domain / ood for ours, external for R-Judge, ATBench and AgentRisk.", "enum": ["in_domain", "ood", "external"]},
    "split":     {"description": "null until the split step has run.", "enum": ["train", "val", "test", null]},
    "domain":    {"description": "Ours only. CUST is OOD only.", "enum": ["FILE", "PRIV", "ACC", "FIN", "REPO", "CAL", "CUST", null]},
    "case_type": {"description": "Ours only.", "enum": ["T1", "T2", "T3", "T4", "T5", null]},
    "subtype":   {"description": "T2 only.", "enum": ["a", "b", "c", "d", null]},
    "pair_side": {"description": "T1 only.", "enum": ["A", "B", null]},
    "version":   {"description": "T3-T5 only.", "enum": ["v1", "v2", null]},
    "task":      {"description": "decide_action = judge one proposed action (ours). judge_trajectory = judge the whole conversation (external).",
                  "enum": ["decide_action", "judge_trajectory"]},
    "visible": {
      "description": "The ONLY part the monitor ever sees.",
      "type": "object",
      "additionalProperties": false,
      "required": ["trajectory", "proposed_action"],
      "properties": {
        "trajectory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}},
        "proposed_action": {"description": "null for external records.", "oneOf": [{"type": "null"}, {"$ref": "#/$defs/call"}]},
        "proposed_action_text": {"description": "AgentRisk only: the free-text proposed action (CLI command or message), the step after the trajectory. Not yet executed.",
                                 "type": ["string", "null"]}
      }
    },
    "hidden": {
      "description": "Simulator state. Never in a prompt. null for external records.",
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["state", "key_facts"],
         "properties": {"state": {"type": "object"}, "key_facts": {"type": "object"}}}
      ]
    },
    "gold": {"$ref": "#/$defs/gold"},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_tokens", "ood_shift"],
      "properties": {
        "writer_llm":        {"description": "Ours: writer LLM name + version.", "type": ["string", "null"]},
        "generator_version": {"type": ["string", "null"]},
        "n_tokens":          {"description": "Qwen3 tokenizer count of the visible part. null until the tokenizer is installed.", "type": ["integer", "null"], "minimum": 0},
        "ood_shift":         {"type": "array", "uniqueItems": true, "items": {"enum": ["new_tools", "new_wording", "new_style", "new_values"]}},
        "category":          {"description": "R-Judge folder: Application, Finance, IoT, Program, Web.", "type": ["string", "null"]},
        "attack_type":       {"description": "R-Judge only.", "enum": ["injection", "unintended", null]},
        "source_file":       {"description": "External only: raw file path, for spot checks.", "type": ["string", "null"]},
        "source_id":         {"description": "External only: id in the raw file.", "type": ["integer", "string", "null"]},
        "flags":             {"description": "AgentRisk only: markers for filtered analysis (src/external/agentrisk.py FLAGS).",
                              "type": "array", "uniqueItems": true,
                              "items": {"enum": ["reply_to_user", "physical_world", "rjudge_prompt_overlap", "rjudge_near_duplicate"]}}
      }
    }
  },
  "$defs": {
    "call": {
      "description": "A structured tool call or proposed action.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "args"],
      "properties": {"name": {"type": "string", "minLength": 1}, "args": {"type": "object"}}
    },
    "message": {
      "description": "One turn. R-Judge free-text actions and ATBench Complete{...} answers go in action_text; ATBench JSON {name, arguments} actions go in tool_call.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "text", "tool_call", "action_text"],
      "properties": {
        "role":        {"enum": ["context", "user", "agent", "tool"]},
        "text":        {"type": "string"},
        "tool_call":   {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/call"}]},
        "action_text": {"type": ["string", "null"]}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "args"],
      "properties": {"tool": {"type": "string", "pattern": "^check_[a-z_]+$"}, "args": {"type": "object"}}
    },
    "gold": {
      "description": "Correct answers. Never in a prompt.",
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "risk_label", "risk_type", "risk_cause", "check_needed", "required_checks",
                   "missing_fact", "policy_ids", "evidence", "source_note", "source_taxonomy"],
      "properties": {
        "decision":        {"enum": ["ALLOW", "ASK_CONFIRMATION", "BLOCK", "ESCALATE", null]},
        "risk_label":      {"enum": ["SAFE", "UNSAFE"]},
        "risk_type":       {"description": "null only while R-Judge human review is unfinished.",
                            "enum": ["DATA_LOSS", "PRIVACY_LEAKAGE", "FINANCIAL_LOSS", "ACCESS_CONTROL", "SECURITY", "OTHER", "NONE", null]},
        "risk_cause":      {"enum": ["ENVIRONMENT_STATE", "USER_REQUEST", "AGENT_ERROR", "POLICY_CONFLICT", "UNTRUSTED_CONTENT", "NONE", null]},
        "check_needed":    {"type": ["boolean", "null"]},
        "required_checks": {"oneOf": [{"type": "null"}, {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/check"}}]},
        "missing_fact":    {"description": "Template: '<attribute> of <resource>'.", "type": ["string", "null"]},
        "policy_ids":      {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "string", "pattern": "^P_[A-Z]+_[0-9]{2}(_R)?$"}}]},
        "evidence": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["facts", "policy_ids"],
             "properties": {"facts": {"type": "array", "items": {"type": "string"}},
                            "policy_ids": {"type": "array", "items": {"type": "string"}}}}
          ]
        },
        "native_labels": {
          "description": "AgentRisk only: the released labels, unchanged (SemEval subtasks 1, 2a, 2b). NEVER in model input.",
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["risk_severity", "risk_domains", "risk_drivers"],
             "properties": {"risk_severity": {"type": "integer", "minimum": 1, "maximum": 5},
                            "risk_domains": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
                            "risk_drivers": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}}}}
          ]
        },
        "source_note":     {"description": "External explanation (R-Judge risk_description, ATBench reason). NEVER in model input.", "type": ["string", "null"]},
        "source_taxonomy": {
          "description": "ATBench unsafe only. null for SAFE (ATBench fills these even for safe records; we drop them).",
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["risk_source", "failure_mode", "real_world_harm"],
             "properties": {"risk_source": {"type": "string"}, "failure_mode": {"type": "string"}, "real_world_harm": {"type": "string"}}}
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "description": "External records: no action, no hidden state, no decision or check fields.",
      "if": {"properties": {"task": {"const": "judge_trajectory"}}},
      "then": {"properties": {
        "source": {"enum": ["r_judge", "atbench", "agentrisk"]},
        "set": {"const": "external"},
        "domain": {"type": "null"}, "case_type": {"type": "null"}, "subtype": {"type": "null"},
        "pair_side": {"type": "null"}, "version": {"type": "null"},
        "hidden": {"type": "null"},
        "visible": {"properties": {"proposed_action": {"type": "null"}}},
        "gold": {"properties": {
          "decision": {"type": "null"}, "check_needed": {"type": "null"}, "required_checks": {"type": "null"},
          "missing_fact": {"type": "null"}, "policy_ids": {"type": "null"}, "evidence": {"type": "null"}}}
      }}
    },
    {
      "description": "R-Judge and ATBench have no risk_cause; AgentRisk gets one from its label map (review sheet Q4).",
      "if": {"properties": {"source": {"enum": ["r_judge", "atbench"]}}},
      "then": {"properties": {"gold": {"properties": {"risk_cause": {"type": "null"}}}}}
    },
    {
      "description": "Our records: action, hidden state, decision and check fields are all required.",
      "if": {"properties": {"task": {"const": "decide_action"}}},
      "then": {"properties": {
        "source": {"const": "synthetic-data"},
        "set": {"enum": ["in_domain", "ood"]},
        "domain": {"type": "string"}, "case_type": {"type": "string"},
        "hidden": {"type": "object"},
        "visible": {"properties": {"proposed_action": {"$ref": "#/$defs/call"}}},
        "gold": {"properties": {
          "decision": {"enum": ["ALLOW", "ASK_CONFIRMATION", "BLOCK", "ESCALATE"]},
          "check_needed": {"type": "boolean"},
          "risk_type": {"type": "string"},
          "risk_cause": {"type": "string"},
          "policy_ids": {"type": "array"},
          "evidence": {"type": "object"}}}
      }}
    },
    {
      "description": "AgentRisk: the proposed action and the released labels are always present.",
      "if": {"properties": {"source": {"const": "agentrisk"}}},
      "then": {"properties": {
        "visible": {"required": ["proposed_action_text"], "properties": {"proposed_action_text": {"type": "string", "minLength": 1}}},
        "gold": {"required": ["native_labels"], "properties": {"native_labels": {"type": "object"}}}}}
    },
    {
      "description": "SAFE always has risk_type NONE and no source taxonomy.",
      "if": {"properties": {"gold": {"properties": {"risk_label": {"const": "SAFE"}}}}},
      "then": {"properties": {"gold": {"properties": {"risk_type": {"const": "NONE"}, "source_taxonomy": {"type": "null"}}}}}
    },
    {
      "description": "UNSAFE never has risk_type NONE.",
      "if": {"properties": {"gold": {"properties": {"risk_label": {"const": "UNSAFE"}}}}},
      "then": {"properties": {"gold": {"properties": {"risk_type": {"not": {"const": "NONE"}}}}}}
    },
    {
      "description": "Our data: risk_label follows the decision (UNSAFE if not ALLOW).",
      "if": {"properties": {"task": {"const": "decide_action"}, "gold": {"properties": {"decision": {"const": "ALLOW"}}}}},
      "then": {"properties": {"gold": {"properties": {"risk_label": {"const": "SAFE"}}}}},
      "else": {"if": {"properties": {"task": {"const": "decide_action"}}},
               "then": {"properties": {"gold": {"properties": {"risk_label": {"const": "UNSAFE"}}}}}}
    },
    {
      "description": "Our data: missing_fact is set when a check is needed. required_checks may be null for now (filled in a later pass once the check tools are final; see docs/seed_to_record.md D4) or a non-empty list; it must be null when no check is needed.",
      "if": {"properties": {"task": {"const": "decide_action"}, "gold": {"properties": {"check_needed": {"const": true}}}}},
      "then": {"properties": {"gold": {"properties": {"required_checks": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1}]}, "missing_fact": {"type": "string"}}}}},
      "else": {"if": {"properties": {"task": {"const": "decide_action"}}},
               "then": {"properties": {"gold": {"properties": {"required_checks": {"type": "null"}, "missing_fact": {"type": "null"}}}}}}
    }
  ]
}
